datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}
enum ItemType {
  PRODUCT
  COURSE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id            Int     @id @default(autoincrement())
  phoneNumber   String  @unique
  password      String?

  firstName     String?
  lastName      String?
  addressDetail String?
  postalCode    String?

  age          Int?
  nationalCode String? @unique
  image        String?

  isVerified Boolean @default(false)
  isAdmin    Boolean @default(false)

  otpCode       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?

  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  cart   Cart?
}

model Course {
  id          String @id @default(uuid())
  title       String
  description String
  price       Int
  duration    String
  instructor  String
  image       String?

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model Product {
  id          String  @id @default(uuid())
  title       String
  category    String
  price       Int     @default(0)
  stock       Int     @default(0)
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model Recipe {
  id           String   @id @default(uuid())
  title        String
  description  String?
  ingredients  String[]
  instructions String
  prepTime     String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum DeliveryMethod {
  PICKUP  
  COURIER 
}

model Order {
  id     String @id @default(uuid())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount Int

  deliveryMethod DeliveryMethod @default(COURIER)

  recipientName   String
  recipientPhone  String
  shippingAddress String?
  postalCode      String?

  cancelReason String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemType ItemType

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  titleSnapshot String
  quantity      Int
  unitPrice     Int
}

model Cart {
  id     String @id @default(uuid())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  itemType ItemType

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@unique([cartId, courseId])
}
