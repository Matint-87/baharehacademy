datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int       @id @default(autoincrement())
  phoneNumber   String    @unique
  password      String?   

  firstName     String?
  lastName      String?
  addressDetail String?
  postalCode    String?

  isVerified    Boolean   @default(false)
  isAdmin       Boolean   @default(false)

  otpCode       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?

  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  duration    String
  instructor  String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Product {
  id           String   @id @default(uuid())
  title        String
  category     String
  pricePerUnit Float
  unitType     String   @default("gram")
  step         Int      @default(100)
  image        String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Recipe {
  id            String   @id @default(uuid())
  title         String
  description   String?
  ingredients   String[]
  instructions  String   
  prepTime      String?  
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
